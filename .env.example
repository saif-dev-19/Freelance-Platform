# Supabase PostgreSQL
# For Vercel/serverless, use Supabase Session Pooler (port 5432) or
# Transaction Pooler (port 6543) credentials from Connect > ORMs.
dbname=postgres
user=postgres.YOUR_PROJECT_REF
password=YOUR_SUPABASE_DB_PASSWORD
host=aws-0-YOUR_REGION.pooler.supabase.com
port=5432

# Cloudinary
cloud_name=YOUR_CLOUDINARY_CLOUD_NAME
cloudinary_api_key=YOUR_CLOUDINARY_API_KEY
api_secret=YOUR_CLOUDINARY_API_SECRET

# Application URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
FRONTEND_PROTOCOL=http
FRONTEND_DOMAIN=localhost:5173

# SMTP used by Djoser email activation/password flows
EMAIL_HOST=smtp.example.com
EMAIL_USE_TLS=True
EMAIL_PORT=587
EMAIL_HOST_USER=YOUR_SMTP_USERNAME
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
EMAIL_TIMEOUT=15
